# Server Configuration
PORT=5001
NODE_ENV=development

# Storage Mode: "memory" (standalone demonstration mode, no MongoDB required) or "mongodb"
STORAGE_MODE=memory

# Demo Seeding: Automatically populate sample topology and 12-sample historical telemetry on startup
SEED_DEMO_DATA=true

# Frontend CORS Configuration (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=*

# Database Configuration (Used only when STORAGE_MODE=mongodb)
MONGODB_URI=mongodb://127.0.0.1:27017/predictive_routing

# Python ML Service Configuration (FastAPI Chronos-2)
ML_SERVICE_URL=http://127.0.0.1:8000

# ML Request Timeouts (in milliseconds)
ML_PREDICT_TIMEOUT_MS=120000
ML_BATCH_TIMEOUT_MS=180000
ML_COST_TIMEOUT_MS=15000
ML_HEALTH_TIMEOUT_MS=5000

# GNS3 Network Emulation Server (Optional - Standby in demo mode)
GNS3_SERVER_URL=http://127.0.0.1:3080
GNS3_PROJECT_ID=
GNS3_TIMEOUT_MS=5000
